{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stop-adedanha-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "triggers": {
    // Cloudflare Quartz: weekdays are 1=SUN … 7=SAT (0 is invalid). Prefer day names.
    // Sundays, Tuesdays and Thursdays at 04:00 UTC (01:00 BRT).
    "crons": ["0 4 * * SUN,TUE,THU"]
  }
}
